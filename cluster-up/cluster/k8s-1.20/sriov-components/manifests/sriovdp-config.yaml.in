---
apiVersion: v1
kind: ConfigMap
metadata:
  name: sriovdp-config
  namespace: kube-system
data:
  config.json: |
    {
      "resourceList": [{
        "resourceName": "$RESOURCE_NAME",
        "selectors": {
          "drivers": $DRIVERS,
          "vendors": ["8086"],
          "devices": ["154c", "10ed", "1889"]
        }
    }]
    }
